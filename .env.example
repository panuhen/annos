# Repo-root .env — read by `docker compose` for ${VAR} interpolation into the
# container environment. Copy to .env; never commit the real file.
#
# The dev container config (database URLs, the API origins) is baked into
# compose.yaml, and the Better Auth dev secret lives in compose.override.yaml,
# so you do NOT set those here. This file carries only what compose reads from
# the environment: the email/Google secrets, the public toggle, and the build
# switch. In production the same names are injected by the deploy environment
# instead.

# --- Build ---
# Disable compose's bake integration. When a machine runs both a system Docker
# daemon and Docker Desktop, bake can pick the wrong builder, whose RUN sandbox
# can't resolve DNS, and `uv sync` then times out during the image build.
# Building on the current context (bake off) avoids it; harmless where bake
# would have worked anyway. Run compose from the repo root so this file is read.
COMPOSE_BAKE=false

# --- Email (Resend) ---
# Transactional mail (verification + password reset) leaves the system only
# from the Next.js identity layer. A blank RESEND_API_KEY makes the senders log
# the link to stdout instead of sending — the zero-config dev path.
RESEND_API_KEY=
# The From address, on a domain verified in THIS Resend account. Blank falls
# back to Resend's shared onboarding@resend.dev, which only delivers to the
# account owner. annos.app is verified (region eu-west-1).
EMAIL_FROM=Annos <noreply@annos.app>

# --- Google sign-in (optional) ---
# Offered only when both credentials are set; the public flag gates the browser
# button. Register the redirect URI {BETTER_AUTH_URL}/api/auth/callback/google.
# Annos keeps neither the name nor the photo Google returns — only the email.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_ENABLED=false

# --- Production only (set in the deploy environment; not needed for local compose) ---
# BETTER_AUTH_SECRET    openssl rand -base64 32 — replaces the dev placeholder
# BETTER_AUTH_URL       the public HTTPS origin (https://annos.app); also the
#                       JWT issuer/audience and the base for OG/robots/sitemap
# APP_URL               optional explicit override of the metadata base; if
#                       unset it falls back to BETTER_AUTH_URL, then the
#                       forwarded-host headers
# NEXT_PUBLIC_MCP_URL   the MCP endpoint shown on Settings → Connect your AI,
#                       e.g. https://mcp.annos.app/mcp
# ANNOS_PUBLIC_BASE_URL / ANNOS_AUTH_JWT_ISSUER / ANNOS_AUTH_JWT_AUDIENCE
#                       the API's public HTTPS origins (compose hardcodes the
#                       localhost values for dev)
# POSTGRES_PASSWORD     the db owner password (defaults to `annos` for dev);
#                       set a strong value in prod
# ANNOS_API_DB_PASSWORD the restricted annos_api role's password (defaults to
#                       `annos` for dev); set a strong value in prod. Only takes
#                       effect on a FRESH db volume — db/init runs once.

# --- Running the API directly on the host (optional; outside compose) ---
# Only needed for `uv run uvicorn annos.app:app` / `alembic` on the host. The
# compose db publishes on 5433 to avoid clashing with a host Postgres.
# ANNOS_DATABASE_URL=postgresql+asyncpg://annos_api:annos@localhost:5433/annos
# Migrations need the owner role; annos_api cannot create tables or even read
# alembic_version.
# ANNOS_MIGRATION_DATABASE_URL=postgresql+asyncpg://annos:annos@localhost:5433/annos
# ANNOS_AUTH_BASE_URL=http://localhost:3000/api/auth
# ANNOS_LOG_LEVEL=INFO
