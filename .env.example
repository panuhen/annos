# Local development. Copy to .env — never commit the real file.
# The compose db publishes on 5433 to avoid clashing with a host Postgres.
ANNOS_DATABASE_URL=postgresql+asyncpg://annos:annos@localhost:5433/annos

# Phase 0 stand-in for the OAuth-resolved caller identity.
# Delete this once real auth lands — see api/src/annos/identity.py
ANNOS_DEV_USER_ID=00000000-0000-0000-0000-000000000001

ANNOS_LOG_LEVEL=INFO
