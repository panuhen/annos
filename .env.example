# Local development. Copy to .env — never commit the real file.
# The compose db publishes on 5433 to avoid clashing with a host Postgres.
ANNOS_DATABASE_URL=postgresql+asyncpg://annos_api:annos@localhost:5433/annos

# Migrations need the owner role; annos_api cannot create tables.
ANNOS_MIGRATION_DATABASE_URL=postgresql+asyncpg://annos:annos@localhost:5433/annos

# Phase 0 stand-in for the OAuth-resolved caller identity. While this is set,
# resolve_caller() skips token validation entirely and every request is this
# subject. Must be unset in production — see api/src/annos/identity.py
ANNOS_DEV_SUBJECT=dev-subject-0001

# Better Auth in the Next.js app is the authorization server. Nothing here
# validates tokens until that exists.
ANNOS_AUTH_BASE_URL=http://localhost:3000/api/auth

ANNOS_LOG_LEVEL=INFO
